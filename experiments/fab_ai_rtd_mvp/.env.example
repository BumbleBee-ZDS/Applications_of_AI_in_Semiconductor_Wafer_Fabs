# ================= 晶圆厂 RTD LLM Agent MVP 环境变量 =================
# 复制本文件为 .env 并填入真实 Key（.env 不要提交到版本库）

# DeepSeek（聊天 / 推理）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 阿里千问 DashScope（文本向量化）
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 国际站默认地址；国内站请改为 https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 向量维度（qwen3.7-text-embedding 支持 1024）
EMBEDDING_DIM=1024
