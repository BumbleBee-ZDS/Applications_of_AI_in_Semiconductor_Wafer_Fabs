# ===== FabGraph MVP 环境变量模板 =====
# 复制为 .env 并填入真实值

# ---- 应用配置 ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ---- LLM 配置 ----
# provider 选择: openai | deepseek
LLM_PROVIDER=deepseek

# OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（与 OpenAI SDK 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Mock 开关：无 API Key 时置 true，使用预设响应
USE_MOCK_LLM=true
USE_MOCK_EMBEDDINGS=true

# ---- 向量嵌入 ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- 数据库 ----
SQLITE_DB_PATH=data/fabgraph.db

# ---- 向量索引 ----
FAISS_INDEX_PATH=data/faiss_index
