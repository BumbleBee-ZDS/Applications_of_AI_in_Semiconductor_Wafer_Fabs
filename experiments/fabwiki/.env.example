# 复制本文件为 .env 并按需填写，即可启用真实 LLM 模式。
# 不配置 LLM_API_KEY 时，项目自动降级为 Mock 模式（离线可完整演示）。

# OpenAI 兼容 API 的 Key（必填才走真实 LLM）
LLM_API_KEY=

# OpenAI 兼容 API 的 base_url（例如 DeepSeek: https://api.deepseek.com/v1）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（例如 deepseek-chat / gpt-4o-mini）
LLM_MODEL=deepseek-chat